# คัดลอกไปเป็น apps/executive/.env.local และ apps/service/.env.local
# mock = ใช้ mock server (pnpm mock, พอร์ต 4000) / live = ต่อ backend CIT
API_MODE=mock
API_BASE_URL=http://localhost:4000
NEXT_PUBLIC_POLL_INTERVAL_MS=30000

# (เฉพาะ executive) สถานะ Hardware จริงจาก api-nexus · เว้นว่าง = ใช้ข้อมูลจำลอง
# เรียกจากฝั่ง server ของเว็บไปที่ IP นี้ตรง ๆ (key ไม่ถูกส่งไปที่เบราว์เซอร์)
CIT_HW_URL=http://172.25.1.38:3917/api/frontend/hw/latest
CIT_HW_KEY=

# (เฉพาะ executive) ยอดรถเข้า-ออก / รายได้ / รถคงค้าง จริงจาก WebSocket ของ Backend · เว้นว่าง = ใช้ข้อมูลจำลอง
CIT_PARKING_WS_URL=ws://172.25.10.42:3000/ws
CIT_PARKING_WS_TOKEN=
# REST สำรองตอน WebSocket หลุด (ไม่ใส่ = ใช้ที่อยู่เดียวกับ WS แล้วเปลี่ยน /ws เป็น /api/dashboard)
CIT_PARKING_REST_URL=

# (เฉพาะ executive) รหัสลับของ webhook ที่ตู้ไม้กั้นยิงสถานะกลับ (POST /api/barrier/hook, header X-Hook-Key)
CIT_BARRIER_HOOK_KEY=
