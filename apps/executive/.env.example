# คัดลอกไปเป็น apps/executive/.env.local และ apps/service/.env.local
# mock = ใช้ mock server (pnpm mock, พอร์ต 4000) / live = ต่อ backend CIT
API_MODE=mock
API_BASE_URL=http://localhost:4000
NEXT_PUBLIC_POLL_INTERVAL_MS=30000

